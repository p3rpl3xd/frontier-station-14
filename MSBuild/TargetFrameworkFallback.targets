<Project>
  <!--
    Last chance before SDK 9 inference. Runs after the project body, so multi-targeted
    projects already have TargetFrameworks set and are left alone. A blank TargetFramework
    becomes Frontier's net9.0 instead of NETSDK1013.
    An empty *global* TargetFramework is only overridable when the csproj sets
    TreatAsLocalProperty="TargetFramework".
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">
    <TargetFramework>net9.0</TargetFramework>
    <TargetFrameworkIdentifier Condition="'$(TargetFrameworkIdentifier)' == ''">.NETCoreApp</TargetFrameworkIdentifier>
    <TargetFrameworkVersion Condition="'$(TargetFrameworkVersion)' == ''">v9.0</TargetFrameworkVersion>
  </PropertyGroup>
</Project>
