<Project>
  <!--
    Hardcoded to Frontier's RobustToolbox 267 (net9.0). Do not read Robust.Engine.props:
    that file may be missing, and a Windows path inside a property function can be mangled.
    The importing project must set TreatAsLocalProperty="TargetFramework" so this still
    wins when MSBuild was given an empty global TargetFramework (/p:TargetFramework=),
    which SDK 9 reports as NETSDK1013.
  -->
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net9.0</TargetFramework>
  </PropertyGroup>
</Project>
