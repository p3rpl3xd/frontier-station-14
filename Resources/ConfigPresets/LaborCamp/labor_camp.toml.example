# Example only. This file is not loaded automatically.
# Paste the block you want into the server config.

[labor_camp]
enabled = true
spawn = false
grid_path = ""
shuttle_grid_path = ""
rock_regrow_minutes = 12
# true: helm lists only the labor camp and the main station. Thrusters do not move the ship.
# false: the helm flies like any other shuttle. LaborCampShuttle and Security can open it either way.
shuttle_locked_route = true
points_per_credit = 1.0
radio_channel = "Nfsd"
spawn_offset_x = 2500
spawn_offset_y = 2500
